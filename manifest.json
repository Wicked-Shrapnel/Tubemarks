{
  "manifest_version": 3,
  "name": "Video Bookmark",
  "version": "1.15.0",
  "description": "Save any HTML5 video with its exact playback position and a note.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "windows"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_popup": "popup.html", "default_title": "Save video bookmark", "default_icon": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"}},
  "icons": {"16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]
}
