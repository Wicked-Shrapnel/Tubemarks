{
  "manifest_version": 3,
  "name": "Video Bookmark",
  "version": "1.2.0",
  "description": "Save any HTML5 video with its exact playback position and a note.",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_popup": "popup.html", "default_title": "Save video bookmark"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]
}
